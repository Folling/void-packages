# Template file for 'teamspeak3'
pkgname=teamspeak3
version=3.6.2
revision=1
archs="x86_64"
hostmakedepends="tar"
depends="bash grep"
short_desc="Popular proprietary voice chat for gaming"
maintainer="Tai Chi Minh Ralph Eastwood <tcmreastwood@gmail.com>"
license="custom:Proprietary"
homepage="http://www.teamspeak.com/"
distfiles="https://files.teamspeak-services.com/releases/client/${version}/TeamSpeak3-Client-linux_amd64-${version}.run"
checksum=59f110438971a23f904a700e7dd0a811cf99d4e6b975ba3aa45962d43b006422
restricted=yes
repository="nonfree"
nopie=yes
nostrip=yes

do_extract() {
	install -m755 ${XBPS_SRCDISTDIR}/${pkgname}-${version}/TeamSpeak3-Client-linux_amd64-${version}.run ${wrksrc}
	sh ./TeamSpeak3-Client-linux_amd64-${version}.run --tar xf
	rm -f TeamSpeak3-Client-linux_amd64-${version}.run
}

do_install() {
	# Set proper permissions
	find -type d | xargs chmod 755
	find -type f | xargs chmod 644
	find -name '*.so*' | xargs chmod 755
	chmod +x ts3client* package_inst QtWebEngineProcess

	# needs legacy libwebp.so.6
	rm ./imageformats/libqwebp.so

	vmkdir "usr/lib/teamspeak3"
	vcopy * "usr/lib/teamspeak3"

	# Install desktop file
	vinstall "${FILESDIR}/teamspeak3.desktop" 644 "usr/share/applications"

	# Install icon file
	vinstall styles/default/logo-128x128.png 644 usr/share/pixmaps/teamspeak3.png

	# Install the license (not present in most recent version)
	# vlicense LICENSE

	# Install client launcher
	vbin "${FILESDIR}/teamspeak3"
}
